# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Provider Configuration (REQUIRED)
# Active provider choices: 'ollama' (default for local demo), 'gemini', 'claude', 'openai'
# ------------------------------------------------------------------------------
LLM_PROVIDER=ollama

# --- Local Ollama Settings (REQUIRED if LLM_PROVIDER=ollama) ---
# On native host: http://localhost:11434
# Inside Docker container: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Google Gemini Settings (REQUIRED if LLM_PROVIDER=gemini) ---
# Get your API key at https://aistudio.google.com/
# Supported models:
#   gemini-3.5-flash-lite (default, ultra-fast, cost-efficient)
#   gemini-3.8-flash      (frontier intelligence and speed)
#   gemini-3.7-flash      (hybrid reasoning and multimodal)
#   gemini-2.5-flash      (stable fast tier)
#   gemini-2.5-pro        (flagship deep reasoning)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Anthropic Claude Settings (REQUIRED if LLM_PROVIDER=claude) ---
# Get your API key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- OpenAI Settings (REQUIRED if LLM_PROVIDER=openai) ---
# Get your API key at https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# Persistence & Database (REQUIRED)
# PostgreSQL with pgvector extension enabled.
# For local Docker Compose, use:
# postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_assistant
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_assistant

# ------------------------------------------------------------------------------
# Embedding & RAG Settings
# FastEmbed model options: 'BAAI/bge-small-en-v1.5' (default, 384-dim)
# or 'sentence-transformers/all-MiniLM-L6-v2'
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SIMILARITY_THRESHOLD=0.45
TOP_K_RESULTS=5

# ------------------------------------------------------------------------------
# Server & Logging (OPTIONAL)
# ------------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
